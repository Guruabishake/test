# AmazerTrans staging credentials — copy this file to ".env" and fill in real values.
# ".env" is gitignored and must never be committed.

AMAZERTRANS_URL=https://staging-fc.cargowayz.net/login/AMAZERTRANS
AMAZERTRANS_USERNAME=amit.sharma@cargowayz.net
AMAZERTRANS_BRANCH=Bengaluru Tech Hub
AMAZERTRANS_PASSWORD=

# How many Customer / Vendor / Enquiry / Quotation records the bulk-creation loops should create.
# Bump these to 10 / 20 / 50 without touching any test code.
CUSTOMER_COUNT=5
VENDOR_COUNT=5
ENQUIRY_COUNT=1
QUOTATION_COUNT=1

# --- Enquiry configuration (e2e/AmazerTrans/utils/testData.ts -> getEnquiryConfig()) ---
# Which service(s) the configuration-driven Enquiry tests select. One of:
#   ALL
#   FREIGHT_FORWARDING
#   CUSTOMS_BROKER
#   TRANSPORT_MANAGEMENT_SYSTEM
# or a comma-separated combination, e.g. FREIGHT_FORWARDING,CUSTOMS_BROKER
ENQUIRY_SERVICE_CONFIG=FREIGHT_FORWARDING

# Export | Import | CROSS TRADE
SHIPMENT_DIRECTION=Export
# Air | Sea | Road | Rail
SHIPMENT_MODE=Air

# Upload File section of the Enquiry Create/Update form.
ENQUIRY_UPLOAD_ENABLED=true
# Leave blank to use the existing default sample asset (e2e/new_folder/assets/sample.png).
ENQUIRY_UPLOAD_FILE=
ENQUIRY_DOCUMENT_TYPE=AIRWAY BILL

# --- Playwright execution ---
# true | false - defaults to headed locally, headless on CI when unset.
HEADLESS=
# off | on | retain-on-failure | on-first-retry - defaults to retain-on-failure when unset.
VIDEO=
# Milliseconds to slow down each Playwright action for manual observation - defaults to 0 (off).
SLOW_MO=
