# AmazerTrans staging credentials — copy this file to ".env" and fill in real values.
# ".env" is gitignored and must never be committed.

AMAZERTRANS_URL=https://staging-fc.cargowayz.net/login/AMAZERTRANS
AMAZERTRANS_USERNAME=amit.sharma@cargowayz.net
AMAZERTRANS_BRANCH=Bengaluru Tech Hub
AMAZERTRANS_PASSWORD=

# --- Multi-user parallel execution (see e2e/AmazerTrans/config/users.config.json - a plain,
# committed JSON file a QA tester can edit directly to add/remove/enable/disable users, no code
# changes needed) ---
# The app allows only ONE active session per account, so every enabled user must resolve to a
# genuinely different real account - never point two entries' usernameEnv/passwordEnv at the same
# credentials. users.config.json's "user1" entry already points at AMAZERTRANS_USERNAME/PASSWORD
# above, so it needs no extra setup. "user2"/"user3"/"user4" (or any further entries you add to
# that JSON file) each need their own usernameEnv/passwordEnv pair defined here - leave them blank
# to keep running only user1 (unaffected), or fill in real distinct accounts to safely run several
# users in parallel (`--project=user1 --project=user2 ... --workers=<N>`).
AMAZERTRANS_USER2_USERNAME=
AMAZERTRANS_USER2_PASSWORD=
AMAZERTRANS_USER3_USERNAME=
AMAZERTRANS_USER3_PASSWORD=
AMAZERTRANS_USER4_USERNAME=
AMAZERTRANS_USER4_PASSWORD=

# How many Customer / Vendor records the bulk-creation loops should create.
# Bump these to 10 / 20 / 50 without touching any test code.
CUSTOMER_COUNT=5
VENDOR_COUNT=5

# Enquiry's 4 required Service combinations (FF+CB, CB+TMS, FF+TMS, FF+CB+TMS), each with its own
# Shipment Direction/Mode, are fixed in code (e2e/AmazerTrans/utils/testData.ts ->
# ENQUIRY_SCENARIOS) rather than env-configured - all 4 always run together in one session, so
# there is nothing to select per run. Quotation Generation processes the same 4 combinations.

# --- Quotation configuration (e2e/AmazerTrans/utils/testData.ts -> generateQuotationData()) ---
# How many Buy Rate entries the test creates per section via the real Add Origin/International/
# Destination popup. Default 5 each.
QUOTATION_ORIGIN_COUNT=5
QUOTATION_INTERNATIONAL_COUNT=5
QUOTATION_DESTINATION_COUNT=5

# Quotation's Upload File tab.
QUOTATION_UPLOAD_ENABLED=true
# Comma-separated list of 2-3 filenames (resolved against e2e/new_folder/assets) or absolute paths.
# Leave blank to use the two existing default sample assets (sample.png, sample2.png).
QUOTATION_UPLOAD_FILES=

# --- Pricing configuration (e2e/AmazerTrans/utils/testData.ts) ---
# Margin % applied to every applicable Sell Rate row on the Pricing screen. Default 10.
PRICING_MARGIN_PERCENT=10

# Contract/Sub Contract's Upload File tabs (both the top-level one and Contract Price's own).
CONTRACT_UPLOAD_ENABLED=true
# Comma-separated list of 2-3 filenames (resolved against e2e/new_folder/assets) or absolute paths.
# Leave blank to use the two existing default sample assets (sample.png, sample2.png).
CONTRACT_UPLOAD_FILES=

# --- CB (Customs Broker) configuration (e2e/AmazerTrans/utils/cbConfig.ts) ---
# Comma-separated subset of importSea,importAir,exportSea,exportAir - which CB scenarios
# cb.spec.ts runs. Leave blank/unset to run all 4. Changes WHICH scenarios run, never how they run.
CB_SCENARIOS=importSea,importAir,exportSea,exportAir

# CB Export Sea's own real Port of Loading value (a real, valid option in the app's own Port of
# Loading master list). Leave blank/unset to default to HARYANA.
CB_EXPORT_SEA_PORT_OF_LOADING=HARYANA

# --- Playwright execution ---
# true | false - defaults to headed locally, headless on CI when unset.
HEADLESS=
# off | on | retain-on-failure | on-first-retry - defaults to retain-on-failure when unset.
VIDEO=
# Milliseconds to slow down each Playwright action for manual observation - defaults to 0 (off).
SLOW_MO=
