# AmazerTrans staging credentials — copy this file to ".env" and fill in real values.
# ".env" is gitignored and must never be committed.

AMAZERTRANS_URL=https://staging-fc.cargowayz.net/login/AMAZERTRANS
AMAZERTRANS_USERNAME=amit.sharma@cargowayz.net
AMAZERTRANS_BRANCH=Bengaluru Tech Hub
AMAZERTRANS_PASSWORD=

# How many Customer / Vendor records the bulk-creation loops should create.
# Bump these to 10 / 20 / 50 without touching any test code.
CUSTOMER_COUNT=5
VENDOR_COUNT=5

# Enquiry's 4 required Service combinations (FF+CB, CB+TMS, FF+TMS, FF+CB+TMS), each with its own
# Shipment Direction/Mode, are fixed in code (e2e/AmazerTrans/utils/testData.ts ->
# ENQUIRY_SCENARIOS) rather than env-configured - all 4 always run together in one session, so
# there is nothing to select per run. Quotation Generation processes the same 4 combinations.

# --- Quotation configuration (e2e/AmazerTrans/utils/testData.ts -> generateQuotationData()) ---
# How many Buy Rate entries the test creates per section via the real Add Origin/International/
# Destination popup. Default 5 each.
QUOTATION_ORIGIN_COUNT=5
QUOTATION_INTERNATIONAL_COUNT=5
QUOTATION_DESTINATION_COUNT=5

# Quotation's Upload File tab.
QUOTATION_UPLOAD_ENABLED=true
# Comma-separated list of 2-3 filenames (resolved against e2e/new_folder/assets) or absolute paths.
# Leave blank to use the two existing default sample assets (sample.png, sample2.png).
QUOTATION_UPLOAD_FILES=

# --- Playwright execution ---
# true | false - defaults to headed locally, headless on CI when unset.
HEADLESS=
# off | on | retain-on-failure | on-first-retry - defaults to retain-on-failure when unset.
VIDEO=
# Milliseconds to slow down each Playwright action for manual observation - defaults to 0 (off).
SLOW_MO=
